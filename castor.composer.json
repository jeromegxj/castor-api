{
    "require": {
        "devizzent/cebe-php-openapi": "^1.1.5",
        "symfony/console": "^7.4|^8.0",
        "symfony/http-foundation": "^7.4|^8.0",
        "symfony/routing": "^7.4|^8.0",
        "symfony/uid": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Castor\\Api\\": "src/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-nktx-f1n1-b4yd": "symfony/yaml v8.1.10 is bundled in the Castor 1.9.1 phar and castor-api never parses YAML. Remove once CI runs Castor 1.9.2+."
                }
            }
        },
        "sort-packages": true
    }
}
