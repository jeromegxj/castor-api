{
    "name": "jeromegxj/castor-api",
    "description": "Expose Castor tasks marked with #[AsApi] over HTTP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jolicode",
            "email": "contact@jolicode.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "devizzent/cebe-php-openapi": "^1.1.5",
        "symfony/console": "^7.4|^8.0",
        "symfony/http-foundation": "^7.4|^8.0",
        "symfony/routing": "^7.4|^8.0",
        "symfony/uid": "^7.4|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Castor\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Castor\\Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
